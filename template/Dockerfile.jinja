# Multi-stage Dockerfile for {{ project_name }}
# Optimized for production deployment with UV package manager

# ============================================================================
# Stage 1: Base Image
# ============================================================================
FROM python:{{ python_version }}-slim AS base

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    {% if database_type == 'postgresql' or database_type == 'supabase' -%}
    libpq-dev \
    {% endif -%}
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Create app user
RUN useradd -m -u 1000 appuser && \
    mkdir -p /app && \
    chown -R appuser:appuser /app

WORKDIR /app

# ============================================================================
# Stage 2: Dependencies
# ============================================================================
FROM base AS dependencies

# Copy dependency files
COPY --chown=appuser:appuser pyproject.toml uv.lock ./
{% if project_type == 'monorepo' -%}
COPY --chown=appuser:appuser packages/ ./packages/
{% endif %}

# Install dependencies
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# ============================================================================
# Stage 3: Build
# ============================================================================
FROM dependencies AS build

# Copy source code
COPY --chown=appuser:appuser . .

# Install the project itself
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# ============================================================================
# Stage 4: Production
# ============================================================================
FROM base AS production

# Copy virtual environment from build stage
COPY --from=build --chown=appuser:appuser /app/.venv /app/.venv
COPY --from=build --chown=appuser:appuser /app /app

# Switch to non-root user
USER appuser

# Add virtual environment to PATH
ENV PATH="/app/.venv/bin:$PATH"

# Set working directory
WORKDIR /app

{% if project_type == 'api' -%}
# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the application
CMD ["uvicorn", "{{ package_name }}.main:app", "--host", "0.0.0.0", "--port", "8000"]
{% elif project_type == 'cli' -%}
# Entry point for CLI
ENTRYPOINT ["{{ package_name }}"]
{% else -%}
# Default command
CMD ["python", "-m", "{{ package_name }}"]
{% endif %}
