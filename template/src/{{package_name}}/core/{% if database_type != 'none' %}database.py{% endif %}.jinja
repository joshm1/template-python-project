{% if database_type != 'none' -%}
"""Database configuration and session management.

Provides async SQLAlchemy engine, session factory, and FastAPI dependency
with automatic transaction management per request.
"""

import os
from collections.abc import AsyncGenerator
from typing import Annotated

from fastapi import Depends
from sqlalchemy.ext.asyncio import AsyncEngine, AsyncSession, async_sessionmaker, create_async_engine
from sqlalchemy.orm import DeclarativeBase


class Base(DeclarativeBase):
    """Base class for SQLAlchemy ORM models."""

    pass


{% if database_type == 'postgresql' -%}
# PostgreSQL database URL
DATABASE_URL = os.getenv(
    "DATABASE_URL",
    "postgresql+asyncpg://postgres:postgres@localhost:5432/{{ project_slug }}",
)
{% elif database_type == 'supabase' -%}
# Supabase PostgreSQL database URL
DATABASE_URL = os.getenv(
    "DATABASE_URL",
    "postgresql+asyncpg://postgres:postgres@localhost:54322/postgres",
)
{% elif database_type == 'sqlite' -%}
# SQLite database URL
DATABASE_URL = os.getenv(
    "DATABASE_URL",
    "sqlite+aiosqlite:///./{{ project_slug }}.db",
)
{% endif %}

# Create async engine with connection pooling
engine: AsyncEngine = create_async_engine(
    DATABASE_URL,
    echo=False,
{% if database_type != 'sqlite' -%}
    pool_size=10,  # Base pool size
    max_overflow=20,  # Allow up to 20 connections beyond pool_size
    pool_timeout=30,  # Seconds to wait for connection from pool
    pool_pre_ping=True,  # Verify connections are still alive before using
{% else -%}
    connect_args={"check_same_thread": False},
{% endif -%}
)

# Create async session factory
# expire_on_commit=False prevents re-querying objects after commit
async_session_maker = async_sessionmaker(
    engine,
    class_=AsyncSession,
    expire_on_commit=False,
)


async def init_db() -> None:
    """Initialize database tables.

    Creates all tables defined in the ORM models.
    In production, use Alembic migrations instead.
    """
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.create_all)


async def get_session() -> AsyncGenerator[AsyncSession, None]:
    """Provide a transactional scope around a series of operations.

    Automatically starts a transaction, commits on success, and rolls back
    on any exception. Each request gets its own session/transaction.

    Yields:
        AsyncSession: Database session with active transaction
    """
    async with async_session_maker() as session:
        async with session.begin():
            yield session
            # Transaction commits automatically when exiting the context
            # If an exception occurs, it rolls back automatically


# Type-safe dependency for FastAPI route injection
SessionDepends = Annotated[AsyncSession, Depends(get_session)]


async def check_database_connection(session: AsyncSession) -> str | None:
    """Check if database connection is healthy.

    Args:
        session: Active database session

    Returns:
        Current database timestamp if healthy, None otherwise
    """
    try:
        from sqlalchemy import text
{% if database_type == 'sqlite' %}
        result = await session.execute(text("SELECT datetime('now')"))
{% else %}
        result = await session.execute(text("SELECT NOW()"))
{% endif %}
        row = result.scalar()
        return str(row) if row else None
    except Exception:
        return None
{% endif -%}
