"""Pytest configuration for {{ project_name }}."""

from typing import Any

import pytest


@pytest.fixture(autouse=True)
def reset_environment(monkeypatch: Any) -> None:
    """Reset environment variables for each test.

    Prevents accidental use of production credentials during testing.
    Add additional sensitive environment variables as needed.
    """
    monkeypatch.delenv("PROD_API_KEY", raising=False)
    monkeypatch.delenv("PROD_DATABASE_URL", raising=False)
{% if database_type == 'supabase' -%}
    # Ensure test environment uses test Supabase
    monkeypatch.setenv("SUPABASE_URL", "http://localhost:54321")
    monkeypatch.setenv("SUPABASE_ANON_KEY", "test-key")
{% endif %}

# Test markers configuration
def pytest_configure(config: Any) -> None:
    """Configure custom pytest markers."""
    config.addinivalue_line(
        "markers",
        "unit: Unit tests that don't require external services",
    )
    config.addinivalue_line(
        "markers",
        "integration: Integration tests that require database/external services",
    )
    config.addinivalue_line(
        "markers",
        "slow: Tests that take longer than 1 second to run",
    )
{% if database_type == 'supabase' %}
    config.addinivalue_line(
        "markers",
        "supabase: Tests that require Supabase services",
    )
{% endif %}
{% if project_type == 'api' %}
    config.addinivalue_line(
        "markers",
        "e2e: End-to-end tests that test full user workflows",
    )
{% endif %}


# Skip tests based on environment conditions
def pytest_collection_modifyitems(config: Any, items: list[Any]) -> None:
    """Modify test collection based on environment.

    This allows conditional skipping of tests that require
    specific services or credentials.
    """
    import os
{% if database_type == 'supabase' %}
    # Skip Supabase tests if local stack is not running
    skip_supabase = pytest.mark.skip(reason="Supabase not available")
    supabase_available = os.getenv("SUPABASE_URL") or False

    for item in items:
        if "supabase" in item.keywords and not supabase_available:
            item.add_marker(skip_supabase)
{% endif %}
    # Skip paid API tests in CI unless explicitly enabled
    skip_paid = pytest.mark.skip(reason="Paid API tests disabled")
    run_paid_tests = os.getenv("RUN_PAID_TESTS", "false").lower() == "true"

    for item in items:
        if "paid" in item.keywords and not run_paid_tests:
            item.add_marker(skip_paid)
