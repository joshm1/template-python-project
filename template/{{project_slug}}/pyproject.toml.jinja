[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
authors = [
    {name = "{{ author_name }}", email = "{{ author_email }}"}
]
readme = "README.md"
requires-python = ">={{ python_version }}"
{% if project_type != 'monorepo' -%}
license = {text = "MIT"}
{% endif -%}
dependencies = [
    {% if project_type == 'cli' -%}
    "click>=8.0.0",
    "rich>=13.0.0",
    "loguru>=0.7.0",
    {% elif project_type == 'api' -%}
    "fastapi>=0.119.0",
    "uvicorn[standard]>=0.38.0",
    "pydantic>=2.0.0",
    "pydantic-settings>=2.0.0",
    {% if database_type == 'postgresql' -%}
    "sqlalchemy[asyncio]>=2.0.0",
    "asyncpg>=0.30.0",
    {% if use_alembic -%}
    "alembic>=1.17.0",
    {% endif -%}
    {% elif database_type == 'supabase' -%}
    "supabase>=2.0.0",
    "httpx>=0.28.0",  # For async requests
    {% elif database_type == 'sqlite' -%}
    "sqlalchemy>=2.0.0",
    "aiosqlite>=0.20.0",
    {% endif -%}
    {% elif project_type == 'library' -%}
    # Add your library dependencies here
    {% endif -%}
]

{% if project_type == 'cli' and use_hatchling -%}
[project.scripts]
{{ project_slug }} = "{{ package_name }}.cli:main"
{% endif %}

{% if project_type == 'monorepo' -%}
[tool.uv.workspace]
members = ["packages/*"]
exclude = ["packages/__pycache__"]
{% endif %}

{% if use_hatchling and project_type != 'monorepo' -%}
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatchling.build.targets.wheel]
packages = ["src/{{ package_name }}"]
{% endif %}

[dependency-groups]
dev = [
    "pyright>=1.1.390",
    "ruff>=0.7.0",
    "pytest>=8.0.0",
    {% if project_type == 'api' or database_type != 'none' -%}
    "pytest-asyncio>=0.24.0",
    "pytest-xdist>=3.6.0",  # Parallel test execution
    "pytest-timeout>=2.3.0",  # Timeout protection
    {% endif -%}
    {% if project_type == 'api' -%}
    "pytest-cov>=5.0.0",
    "httpx>=0.28.0",  # For testing FastAPI
    {% endif -%}
    "pre-commit>=4.0.0",
]

{% if project_type == 'monorepo' -%}
[tool.uv]
required-version = ">=0.8.0,<0.9.0"
{% endif %}

[tool.ruff]
line-length = 120
target-version = "py{{ python_version|replace('.', '') }}"
fix = true

[tool.ruff.lint]
select = [
    "E",      # pycodestyle errors
    "W",      # pycodestyle warnings
    "F",      # pyflakes
    "I",      # isort
    "N",      # pep8-naming
    "UP",     # pyupgrade
    "B",      # flake8-bugbear
    "C4",     # flake8-comprehensions
    "PTH",    # flake8-use-pathlib
    "RUF",    # ruff-specific
]

ignore = []

[tool.ruff.lint.per-file-ignores]
"tests/*.py" = ["S101"]  # Allow assert in tests

[tool.pyright]
typeCheckingMode = "strict"
pythonVersion = "{{ python_version }}"
pythonPlatform = "All"

{% if project_type == 'monorepo' -%}
include = ["packages", "scripts"]
exclude = [
    "**/.*",
    "**/__pycache__",
    "**/node_modules",
    "**/venv",
    "**/_*",
    "**/tmp",
]

extraPaths = [
    "packages/*/src",
    "packages/*/tests",
]

strict = ["packages"]
{% else -%}
include = ["src"]
exclude = [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/node_modules",
    ".venv",
    "**/_*",
    "**/tmp",
]
venvPath = "."
venv = ".venv"
{% endif %}

# Comprehensive error reporting
reportMissingImports = true
reportMissingTypeStubs = false  # Pragmatic for third-party libs
reportUnknownParameterType = true
reportUnknownArgumentType = true
reportUnknownVariableType = true
reportUnknownMemberType = true
reportMissingTypeArgument = true

# Optional handling
reportOptionalSubscript = true
reportOptionalMemberAccess = true
reportOptionalCall = true
reportOptionalIterable = true
reportOptionalContextManager = true
reportOptionalOperand = true

# Unused code detection
reportUnusedImport = true
reportUnusedVariable = true
reportUnusedFunction = true
reportUnusedClass = true
reportUnusedCoroutine = true

# Other important checks
reportPrivateImportUsage = true
reportConstantRedefinition = true
reportIncompatibleMethodOverride = true
reportIncompatibleVariableOverride = true
reportUnnecessaryTypeIgnoreComment = true
reportInvalidTypeVarUse = true
reportUnknownLambdaType = true
reportTypedDictNotRequiredAccess = true
reportOverlappingOverload = true

# Use library code for type inference
useLibraryCodeForTypes = true

# Custom stubs (create stubs/ directory if needed)
stubPath = "stubs"

{% if database_type != 'none' or project_type == 'api' -%}
[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]
{% if project_type == 'api' or database_type != 'none' -%}
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
{% endif -%}
{% if project_type == 'monorepo' -%}
pythonpath = ["packages/*/src", "packages/*/tests"]
addopts = [
    "-n=auto",           # Parallel execution
    "--dist=worksteal",  # Dynamic distribution
    "--timeout=20",      # 20 second timeout per test
]
markers = [
    "unit: Unit tests (fast, isolated)",
    "integration: Integration tests (slower, external deps)",
    "slow: Slow tests",
    "e2e: End-to-end tests",
]
{% else -%}
addopts = [
    {% if project_type == 'api' or database_type != 'none' -%}
    "-n=auto",           # Parallel execution
    "--dist=worksteal",  # Dynamic distribution
    {% endif -%}
    "--timeout=20",      # 20 second timeout per test
]
markers = [
    "unit: Unit tests (fast, isolated)",
    "integration: Integration tests (slower, external deps)",
    "slow: Slow tests",
    {% if project_type == 'api' -%}
    "e2e: End-to-end tests",
    {% endif -%}
]
{% endif -%}
{% endif %}
