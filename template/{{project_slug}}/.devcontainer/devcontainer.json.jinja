{
  "name": "{{ project_name }}",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",

  "customizations": {
    "vscode": {
      "extensions": [
        // Python
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",

        // File format support
        "tamasfe.even-better-toml",      // TOML (pyproject.toml)
        "redhat.vscode-yaml",            // YAML (docker-compose, GitHub Actions)
        "skellock.just",                 // Justfile syntax

        // Docker (always included)
        "ms-azuretools.vscode-docker",

        // Git & productivity
        "eamodio.gitlens",
        "sleistner.vscode-fileutils",

        // AI
        "anthropic.claude-code",

        // Editor enhancements
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
        "python.terminal.activateEnvironment": true,

        // Ruff
        "ruff.format.args": ["--config", "/workspace/pyproject.toml"],
        "ruff.lint.args": ["--config", "/workspace/pyproject.toml"],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },

        // Pyright
        "python.analysis.typeCheckingMode": "strict",
        "python.analysis.diagnosticMode": "workspace",

        // Terminal configuration
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.scrollback": 10000,

        // File exclusions (keep explorer clean)
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/.ruff_cache": true,
          "**/.mypy_cache": true
        },

        // Editor
        "editor.rulers": [88, 120],
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true
      }
    }
  },

  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh-host,type=bind,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig-host,type=bind,readonly",
    {% if database_type != 'none' or project_type == 'api' -%}
    // Volume for Python venv (much faster than bind mount)
    "source=${localWorkspaceFolderBasename}-venv,target=/workspace/.venv,type=volume",
    {% endif -%}
    // MCP authentication for Claude Code
    "source=${localEnv:HOME}/.mcp-auth,target=/home/vscode/.mcp-auth,type=bind"
  ],

  "containerEnv": {
    "WORKSPACE_DIR": "/workspace",
    "HOST_WORKSPACE_DIR": "${localWorkspaceFolder}",
    "COMPOSE_PROJECT_NAME": "${localWorkspaceFolderBasename}",
    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1"{% if database_type == 'postgresql' %},
    "DATABASE_URL": "postgresql://postgres:postgres@db:5432/${localWorkspaceFolderBasename}",
    "DB_HOST": "db",
    "DB_PORT": "5432"{% elif database_type == 'sqlite' %},
    "DATABASE_URL": "sqlite:///${WORKSPACE_DIR}/db.sqlite3"{% elif database_type == 'supabase' %},
    "SUPABASE_URL": "http://kong:8000",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0",
    "SUPABASE_SERVICE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU"{% endif %}
  },

  {% if project_type == 'api' -%}
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "{{ project_name }} API",
      "onAutoForward": "notify"
    }
  },
  {% endif -%}

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  }
}
