version: '3.8'

services:
  devcontainer:
    build:
      context: .
      dockerfile: Dockerfile

    volumes:
      - ..:/workspace:cached

    command: sleep infinity

    {% if database_type == 'postgresql' -%}
    depends_on:
      db:
        condition: service_healthy
    {% elif database_type == 'supabase' and use_supabase_local -%}
    depends_on:
      db:
        condition: service_healthy
    {% endif %}

{% if database_type == 'postgresql' -%}
  db:
    image: postgres:16-alpine
    restart: unless-stopped
    volumes:
      - postgres-data:/var/lib/postgresql/data
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{ project_slug }}
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
{% elif database_type == 'supabase' and use_supabase_local -%}
  # Supabase local development stack
  # For full Supabase stack, see: ../supabase/docker-compose.yml
  # Here we only include the essential DB service for devcontainer
  db:
    image: supabase/postgres:17.6.1.052
    restart: unless-stopped
    command:
      - postgres
      - -c
      - config_file=/etc/postgresql/postgresql.conf
      - -c
      - log_min_messages=fatal
    volumes:
      - postgres-data:/var/lib/postgresql/data
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{ project_slug }}
      POSTGRES_PORT: 5432
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres", "-h", "localhost"]
      interval: 5s
      timeout: 5s
      retries: 10
{% endif %}

volumes:
{% if database_type == 'postgresql' or (database_type == 'supabase' and use_supabase_local) -%}
  postgres-data:
{% endif %}
